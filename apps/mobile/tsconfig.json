{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "esnext"
    ],
    "moduleResolution": "bundler",
    "paths": {
      "@easyeng/types": [
        "../../packages/types/src"
      ],
      "@easyeng/core": [
        "../../packages/core/src"
      ],
      "@easyeng/core/adapters": [
        "../../packages/core/src/adapters/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}