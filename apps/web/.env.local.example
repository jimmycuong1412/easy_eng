# Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# Application
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EasyEng

# =============================================================================
# Supabase
# =============================================================================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# CometChat (Video Calls)
# =============================================================================
# Get these from your CometChat dashboard
NEXT_PUBLIC_COMETCHAT_APP_ID=your-cometchat-app-id
NEXT_PUBLIC_COMETCHAT_REGION=your-region
NEXT_PUBLIC_COMETCHAT_AUTH_KEY=your-auth-key
COMETCHAT_API_KEY=your-api-key

# =============================================================================
# Payment Gateways (Vietnam)
# =============================================================================
# VNPay
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api

# ZaloPay
ZALOPAY_APP_ID=your-zalopay-app-id
ZALOPAY_KEY1=your-zalopay-key1
ZALOPAY_KEY2=your-zalopay-key2
ZALOPAY_API_URL=https://sb-openapi.zalopay.vn/v2

# =============================================================================
# Stripe (International Fallback)
# =============================================================================
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# =============================================================================
# Email (Resend)
# =============================================================================
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@easyeng.com

# =============================================================================
# Analytics (Optional) - Choose ONE provider
# =============================================================================
# Plausible Analytics (Recommended - Privacy-first, GDPR compliant, no cookies)
# Get this from your Plausible account: https://plausible.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=easyeng.com

# Google Analytics (Fallback - only if Plausible is not configured)
# Get this from Google Analytics: https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# Feature Flags
# =============================================================================
NEXT_PUBLIC_ENABLE_CAREER_AVATARS=true
NEXT_PUBLIC_ENABLE_COOKIE_SYSTEM=true
NEXT_PUBLIC_ENABLE_LIVE_VIDEO=true
